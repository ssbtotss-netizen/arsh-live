const c4=A.alCfg({don:{base:"USD"},rules:[{id:"eq",alertId:"E",event:"donation",cond:{op:"eq",value:7},priority:95},{id:"bt",alertId:"B",event:"donation",cond:{op:"between",value:40,value2:60},priority:80},...tiers]});
ok(A.alertsOnEvent(c4,A.alNewState(),{type:"donation",id:"e1",verified:true,amount:7,currency:"USD",name:"x"},1)[0].alertId==="E"&&A.alertsOnEvent(c4,A.alNewState(),{type:"donation",id:"e2",verified:true,amount:45,currency:"USD",name:"x"},1)[0].alertId==="B","advanced: equals / between with priorities");
const c5=A.alCfg({don:{base:"USD"},rules:[...tiers,{id:"also",alertId:"X",event:"donation",cond:{op:"gte",value:100},also:true}]}); ok(A.alertsOnEvent(c5,A.alNewState(),{type:"donation",id:"m",verified:true,amount:100,currency:"USD",name:"x"},1).length===2,"second alert only when explicitly enabled (also)");
const an=A.alertsOnEvent(cfg,A.alNewState(),{type:"donation",id:"an",verified:true,amount:5,currency:"USD",anonymous:true,name:"سر",avatar:"http://a"},1)[0]; ok(an.vars.display_name==="داعم مجهول"&&!an.vars.avatar,"anonymous donor: name & photo hidden");
const ov=A.alCfg({don:{base:"USD"},rules:[{id:"o",alertId:"O",event:"donation",cond:{op:"gte",value:1},over:{durationSec:70,cfg:{title:{x:20,y:30,color:"#ff0000"},sub:{color:"#00ff00"},font:"kufi"}}}]});
