modApply(M, { act: "ban", platform: "youtube", uid: "y1", name: "x" }, now); ok(modHidden(M, msg({ platform: "youtube", uid: "y1" }), now + 9e9), "ban: hidden until unbanned");
modApply(M, { act: "unban", platform: "youtube", uid: "y1" }, now); ok(!modHidden(M, msg({ platform: "youtube", uid: "y1" }), now), "unban");
modApply(M, { act: "delete", platform: "tiktok", uid: "u2", msgId: "MX" }, now); ok(modHidden(M, msg({ id: "MX", uid: "u2" }), now) && !modHidden(M, msg({ id: "MY", uid: "u2" }), now), "delete hides only that message");
const p = modPin(M, msg({ id: "P1", text: "رسالة مهمة" }), 30, now); ok(modPinActive(M, now + 1000)?.m.id === "P1" && !modPinActive(M, now + 31000), "pin for 30 s then it ends");
modPin(M, msg({ id: "P2" }), 0, now); ok(modPinActive(M, now + 9e9)?.m.id === "P2", "pin until manually unpinned");
const A = modAutoCfg({ on: true, words: ["سبونسر"], links: true, allowDomains: ["b6o6"], rate: { on: true, n: 3, sec: 10 } }), S = modAutoState();
ok(modCheck(A, S, M, msg({ text: "يا حمار" }), now)?.rule === "profanity", "profanity (Arabic) caught");
ok(!modCheck(A, S, M, msg({ text: "مساء الخير يا شباب", uid: "ok1" }), now), "normal message passes");
ok(modCheck(A, S, M, msg({ text: "تعالوا سبونسر" , uid: "w" }), now)?.rule === "words", "creator's banned word");
ok(modCheck(A, S, M, msg({ text: "ادخلوا www.spam.com", uid: "l" }), now)?.rule === "links" && !modCheck(A, S, M, msg({ text: "b6o6.com/x", uid: "l2" }), now), "links blocked except allowed domains");
ok(modCheck(A, S, M, msg({ text: "واااااااااااااااااااااااااااااااااااا", uid: "s" }), now)?.rule === "spam", "spam (character flood)");
const d1 = modCheck(A, S, M, msg({ text: "السلام عليكم", uid: "d" }), now), d2 = modCheck(A, S, M, msg({ text: "السلام عليكم", uid: "d" }), now + 5000); ok(!d1 && d2?.rule === "dup", "duplicate message within 30 s");
let r: any = null; for (let i = 0; i < 5; i++) r = modCheck(A, S, M, msg({ text: "رسالة " + i, uid: "r" }), now + i * 100); ok(r?.rule === "rate", "rate limit: 5 messages in 10 s (limit 3)");
modApply(M, { act: "mod", platform: "tiktok", uid: "mm" }, now); ok(!modCheck(A, S, M, msg({ text: "يا حمار", uid: "mm" }), now), "moderators exempt");
ok(!modCheck({ ...A, on: false }, S, M, msg({ text: "يا حمار" }), now), "auto moderation off by default → nothing");
ok(modAutoCfg({}).on === false && modAutoCfg({}).native === false, "defaults: auto-mod off, native platform actions off");
