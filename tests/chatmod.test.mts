import { modState, modApply, modHidden, modPin, modPinActive, modCheck, modAutoState, modAutoCfg, modCaps, modKey } from "../arsh-live/src/engine/chatmod.js";
let pass = 0, fail = 0; const ok = (c: any, m: string) => { c ? pass++ : (fail++, process.stdout.write("FAIL " + m + "\n")); };
const now = 1_800_000_000_000, C: any = {}, M = modState(C);
const msg = (o: any) => ({ id: "m" + Math.random(), kind: "msg", platform: "tiktok", uid: "u1", name: "أحمد", text: "هلا", ...o });
modApply(M, { act: "timeout", platform: "tiktok", uid: "u1", name: "أحمد", sec: 60 }, now);
ok(modHidden(M, msg({}), now + 1000) && !modHidden(M, msg({}), now + 61000), "mute 60 s: hidden, then visible after it ends");
ok(!modHidden(M, msg({ platform: "kick" }), now + 1000), "same name/id on another platform is a different viewer");
